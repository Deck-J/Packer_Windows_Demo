# Local Terraform working data (state lives in the GCS bucket, never here)
infra/.terraform/
infra/.terraform.lock.hcl.bak
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# Packer
packer/manifest.json
packer/*.log

# .NET build output — scoped to the projects, because this repo has its own bin/ tooling that must be tracked
src/**/bin/
src/**/obj/
TestResults/
*.trx
*.user

# Outputs of a local run
lb-ip.txt
/tmp/
.env
.env.*
