$ErrorActionPreference = "Stop"

$publicKey = "${ssh_public_key}"
$sshDir = "C:\Users\packer\.ssh"
$authorizedKeys = Join-Path $sshDir "authorized_keys"

$sshCapability = Get-WindowsCapability -Online -Name OpenSSH.Server~~~~0.0.1.0
if ($sshCapability.State -ne "Installed") {
  Add-WindowsCapability -Online -Name OpenSSH.Server~~~~0.0.1.0
}

if (-not (Get-LocalUser -Name "packer" -ErrorAction SilentlyContinue)) {
  New-LocalUser -Name "packer" -NoPassword -AccountNeverExpires -PasswordNeverExpires
}
Add-LocalGroupMember -Group "Administrators" -Member "packer" -ErrorAction SilentlyContinue

New-Item -ItemType Directory -Path $sshDir -Force | Out-Null
Set-Content -Path $authorizedKeys -Value $publicKey
icacls.exe $sshDir /inheritance:r /grant "packer:(OI)(CI)F" "SYSTEM:(OI)(CI)F" "Administrators:(OI)(CI)F" | Out-Null
icacls.exe $authorizedKeys /inheritance:r /grant "packer:F" "SYSTEM:F" "Administrators:F" | Out-Null

New-Item -Path "HKLM:\SOFTWARE\OpenSSH" -Force | Out-Null
New-ItemProperty -Path "HKLM:\SOFTWARE\OpenSSH" -Name "DefaultShell" -Value "C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe" -PropertyType String -Force | Out-Null

New-NetFirewallRule -Name "OpenSSH-Server-In-TCP" -DisplayName "OpenSSH Server (sshd)" -Enabled True -Direction Inbound -Protocol TCP -Action Allow -LocalPort 22 -ErrorAction SilentlyContinue | Out-Null
Set-Service -Name sshd -StartupType Automatic
Start-Service -Name sshd

$installDir = "C:\WorkerDemo"
$archivePath = Join-Path $installDir "worker-demo.zip"
$logPath = "C:\WorkerDemo-startup.log"

New-Item -ItemType Directory -Path $installDir -Force | Out-Null
Set-Content -Path $logPath -Value "OpenSSH enabled; waiting for point-to-point application transfer"
